{
  "name": "form0-react",
  "version": "0.0.1-alpha.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "description": "React bindings for form0 ecosystem.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./theme.css.js": {
      "import": "./dist/theme.css.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "echo 'no tests yet'",
    "format": "prettier --write \"**/*.{js,jsx,json,ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,ts,tsx,md}\""
  },
  "keywords": [
    "form",
    "form-builder",
    "form-generator",
    "form-engine",
    "schema",
    "json-schema",
    "react",
    "react-native",
    "dynamic-forms",
    "ui",
    "component-library",
    "design-system",
    "form-components",
    "form-ui"
  ],
  "author": "paqu.io <hello@paqu.io>",
  "contributors": [
    {
      "name": "aragornii"
    }
  ],
  "license": "MIT",
  "peerDependencies": {
    "@vanilla-extract/css": "^1.17.4",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/esbuild-plugin": "^2.3.18",
    "ignore": "^7.0.5",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-switch": "^1.2.5",
    "form0-core": "^0.1.0-0",
    "lucide-react": "^0.553.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paqu-io/form0-react.git"
  },
  "bugs": {
    "url": "https://github.com/paqu-io/form0-react/issues"
  },
  "homepage": "https://form0.dev"
}
