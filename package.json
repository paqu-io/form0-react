{
  "name": "form0-react",
  "version": "0.1.29",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "description": "React bindings for form0, the open-source schema-driven form ecosystem by paqu.io. Hooks and components that render a JSON form schema with your own design system.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./theme.css.js": {
      "import": "./dist/theme.css.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{js,jsx,json,ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,ts,tsx,md}\""
  },
  "keywords": [
    "form0",
    "paqu-io",
    "react",
    "react-hooks",
    "form-engine",
    "schema-driven-forms",
    "json-schema",
    "dynamic-forms",
    "conditional-logic",
    "form-validation",
    "headless-forms",
    "form-components"
  ],
  "author": "paqu.io <hello@paqu.io> (https://paqu.io/)",
  "contributors": [
    {
      "name": "aragornii"
    }
  ],
  "license": "MIT",
  "peerDependencies": {
    "@vanilla-extract/css": "^1.17.4",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/esbuild-plugin": "^2.3.18",
    "ignore": "^7.0.5",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-switch": "^1.2.5",
    "form0-core": "^0.1.26",
    "lucide-react": "^0.553.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paqu-io/form0-react.git"
  },
  "bugs": {
    "url": "https://github.com/paqu-io/form0-react/issues"
  },
  "homepage": "https://form0.dev"
}
